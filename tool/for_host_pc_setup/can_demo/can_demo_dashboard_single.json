        },
        "content": "<style>\niframe {\n  border:none;\n  width:100%;\n  height:90%;\n}\n    .demo_text {\n      font-size: 3.5em;\n    }\n\n    .demo_btn {\n      background-color: #199319;\n      color: white;\n      padding: 2px 10px;\n      font-size: 1.8em;\n      font-size: 3.0em;\n      width: 99%;\n      border-radius: 100px;\n    }\n\n    .btn_ON {\n      background-color: #cc3333;\n    }\n\n    .btn_OFF {\n      background-color: #333333;\n    }\n    label, input, textarea {\n      font-size: 1.5em;\n    }\n</style>\n<div style=\"width: 100%; height: 100%;\">\n<button class=\"\" id=\"CANVIEWER\" onclick=\"canviewer_reset();\" value=\"OFF\">CANVIEWER: RESET</button>\n<iframe></iframe>\n<div>\n<script>\nvar iframe = document.querySelector(\"iframe\");\nvar uri = new URL(window.location.href);\n\nvar target_url = \"http://\" + uri.hostname + \":8000\";\niframe.setAttribute('src', target_url);\n</script>\n\n<script>\n  function get_req_v2(url) {\n    var xhr = new XMLHttpRequest();\n    xhr.open(\"GET\", url);\n    xhr.send();\n    xhr.onload = () => {\n      console.log(\"Get response\", xhr.response);\n    };\n  }\n  function canviewer_reset() {\n    var hostname = window.location.hostname;\n    var url = \"http://\" + hostname + \":9000/canviewer/RESET/\";\n    get_req_v2(url);\n  }\n</script>\n",
        "mode": "html"
      },
      "pluginVersion": "11.1.0",
      "type": "text"
    },
