        "content": "<body>\n  <style>\n    .demo_text {\n      font-size: 3.5em;\n    }\n\n    .demo_btn {\n      background-color: #199319;\n      color: white;\n      padding: 2px 10px;\n      font-size: 1.8em;\n      font-size: 3.0em;\n      width: 99%;\n      border-radius: 100px;\n    }\n\n    .btn_ON {\n      background-color: #cc3333;\n    }\n\n    .btn_OFF {\n      background-color: #333333;\n    }\n    label, input, textarea {\n      font-size: 1.5em;\n    }\n  </style>\n\n  <button class=\"demo_btn btn_OFF\" id=\"CANFDTEST\" onclick=\"btn_proc('CANFDTEST');\" value=\"OFF\">CANFDTEST: OFF</button>\n\n  <form id=\"canfdtest_form\">\n\n    <label for=\"send_canid\">Send CAN ID(Hex):</label>\n    <input autocomplete=\"off\" type=\"text\" id=\"send_canid\" required minlength=\"1\" maxlength=\"10\" size=\"7\" value=\"0x501\"/>\n    <br />\n    <label for=\"recv_canid\">Recv CAN ID(Hex):</label>\n    <input autocomplete=\"off\" type=\"text\" id=\"recv_canid\" required minlength=\"1\" maxlength=\"10\" size=\"7\" value=\"0x302\"/>\n    <br />\n    <label for=\"testdatasize\">Test Datasize[Byte]:</label>\n    <input autocomplete=\"off\" type=\"text\" id=\"testdatasize\" required minlength=\"1\" maxlength=\"2\" size=\"1\" value=\"64\"/>\n    <!-- <br />\n    Currently not supported: <label for=\"send_frame_cnt\">Number of frame in flight</label> -->\n    <input autocomplete=\"off\" type=\"hidden\" id=\"send_frame_cnt\"  required minlength=\"1\" maxlength=\"2\" size=\"1\" value=\"20\"/>\n    <br />\n    <label for=\"enable_canfd\">Enable CAN-FD frame</label>\n    <input autocomplete=\"off\" type=\"checkbox\" id=\"enable_canfd\" checked />\n    <br/>\n    <label for=\"enable_brs\">Bit Rate Switch(BRS)</label>\n    <input autocomplete=\"off\" type=\"checkbox\" id=\"enable_brs\" />\n    <br/>\n    <label for=\"enable_brs\">Executed Command: </label>\n    <input autocomplete=\"off\" type=\"text\" id=\"canfdtest_cmd\" required minlength=\"1\" maxlength=\"8\" size=\"42\"\n      value=\"canfdtest canX -gvx -d -f20 -s64 -i0x501 -o0x302\" readonly/>\n\n    <input type=\"hidden\" id=\"canfdtest_common\" value=\"canfdtest canX\" readonly/>\n    </form> \n\n<script>\n  const formTestInputValue = document.forms.canfdtest_form;\n  formTestInputValue.addEventListener('input',()=>{\n    let cmdbox = document.getElementById(\"canfdtest_cmd\");\n\n    let send_canid     = document.getElementById('send_canid').value;\n    let recv_canid     = document.getElementById('recv_canid').value;\n    let test_size      = document.getElementById('testdatasize').value;\n    let send_frame_cnt = document.getElementById('send_frame_cnt').value;\n    let common_part    = document.getElementById('canfdtest_common').value;\n\n    let enable_canfd = document.getElementById('enable_canfd').checked;\n    let enable_brs   = document.getElementById('enable_brs').checked;\n    let options = \" -gvx\"\n    if(enable_canfd) options += \" -d\";\n    if(enable_brs)   options += \" -b\";\n    console.log(\"enable_canfd\", enable_canfd);\n    cmdbox.value = common_part + options + \" -f\"+send_frame_cnt+ \" -i\"+send_canid+\" -o\"+recv_canid+\" -s\"+test_size;\n  })\n</script>\n\n  <script>\n    function getBtnState() {\n      var t = document.getElementById(\"Attack\");\n      return t.value;\n    }\n    function btn_proc(btnId, status = \"dummy\") {\n      // toggle button\n      var t = document.getElementById(btnId);\n      if (t.value == \"ON\") {\n        t.value = \"OFF\";\n      }\n      else if (t.value == \"OFF\") {\n        t.value = \"ON\";\n      }\n      t.innerHTML = btnId + \": \"+t.value\n      t.className = \"demo_btn btn_\"+t.value;\n\n      // Proc each function\n      if (btnId == \"CANFDTEST\") {\n        let cmdbox = document.getElementById(\"canfdtest_cmd\");\n        canfdtest_control(t.value, cmdbox.value);\n      }\n    }\n  </script>\n\n  <script>\n    function get_req_v2(url) {\n      var xhr = new XMLHttpRequest();\n      xhr.open(\"GET\", url);\n      xhr.send();\n      xhr.onload = () => {\n        console.log(\"Get response\", xhr.response);\n      };\n    }\n    function canfdtest_control(state, command) {\n      var hostname = window.location.hostname;\n      var url = \"http://\" + hostname + \":9000/canfdtest/\" + state;\n      command.split(\" \").slice(2).forEach(function(item){\n        url += \"/\" + item\n      })\n      get_req_v2(url);\n    }\n  </script>\n\n</body>",
        "mode": "html"
      },
      "pluginVersion": "11.1.0",
      "type": "text"
    }
  ],
