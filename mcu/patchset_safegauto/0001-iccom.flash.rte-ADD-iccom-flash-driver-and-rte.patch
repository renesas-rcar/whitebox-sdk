diff --git a/vm_atk2/vm1_atk2/flash/rpc_qspi_driver.c b/vm_atk2/vm1_atk2/flash/rpc_qspi_driver.c
new file mode 100644
index 0000000..53ade28
--- /dev/null
+++ b/vm_atk2/vm1_atk2/flash/rpc_qspi_driver.c
@@ -0,0 +1,580 @@
+#include <stdlib.h>
+#include "rpc_qspi_driver.h"
+#include "rpc_reg.h"
+#include "Os.h"
+
+#define RPC_CLK_40M				0x01
+#define RPC_CLK_80M				0x02
+#define RPC_CLK_160M			0x03
+
+// s25s512s status bits
+#define FLASH_STATUS_BUSY				BIT0
+#define FLASH_STATUS_READY				BIT1
+#define FLASH_STATUS_ERASE_ERROR		BIT5
+#define FLASH_STATUS_PROGRAM_ERROR		BIT6
+
+#define TIMER_TICK_INTERVAL_NS		(125U)
+#define TIMER_TICKS_PER_MS			(1000000U/TIMER_TICK_INTERVAL_NS)
+
+static void soft_delay(uint32 loop)
+{
+	uint32 i;
+	for(i=0;i<loop;i++);
+}
+
+static void wait_ms(uint32 delay)
+{
+	TickType start_val, curr_val;
+	delay *= TIMER_TICKS_PER_MS;
+
+	GetCounterValue(MAIN_HW_COUNTER, &start_val);
+	do {
+		GetCounterValue(MAIN_HW_COUNTER, &curr_val);
+	} while ((curr_val - start_val) < delay);
+}
+
+static void set_rpc_clock_mode(uint32 mode)
+{
+	uint32 dataL=0;
+
+	if(mode == RPC_CLK_160M){
+		dataL = 0x00000011;	/* RPC clock 160MHz */
+	}else if(mode == RPC_CLK_80M){
+		dataL = 0x00000013;	/* RPC clock 80MHz */
+	}else{
+		dataL = 0x00000017;	/* RPC clock 40MHz */
+	}
+
+	*((volatile uint32*)CPG_CPGWPR)   = ~dataL;
+	*((volatile uint32*)CPG_RPCCKCR)  =  dataL;
+
+	soft_delay(50000);
+}
+
+static void wait_rpc_tx_end(void)
+{
+	uint32 dataL=0;
+
+	while(1)
+	{
+		dataL = *((volatile uint32*)RPC_CMNSR);
+		if(dataL & BIT0)	break;
+		/*  Wait for TEND = 1 */
+	}
+}
+
+static void reset_rpc(void)
+{
+	*((volatile uint32*)CPG_CPGWPR) = ~BIT29;
+	*((volatile uint32*)CPG_SRCR6)  =  BIT29;
+	/* wait: tRLRH Reset# low pulse width 10us */
+	/* micro_wait(20);		/\*  wait 20us *\/ */
+	wait_ms(1);
+
+	*((volatile uint32*)CPG_CPGWPR)   = ~BIT29;
+	*((volatile uint32*)CPG_SRSTCLR6) =  BIT29;
+	/* wait: tREADY1(35us) - tRHSL(10us) = 25us */
+	/* micro_wait(40);		/\*  wait 40us *\/ */
+	wait_ms(1);
+}
+
+static void set_rpc_ssl_delay(void)
+{
+	*((volatile uint32*)RPC_SSLDR) = 0x00000400;
+	/* bit10-8  SLNDL[2:0] =  100 : 5.5 cycles of QSPIn_SPCLK  */
+}
+
+static void power_on_rpc(void)
+{
+	uint32 dataL=0;
+	dataL = *((volatile uint32*)CPG_MSTPSR6);
+	if(dataL & BIT29){	/*  case RPC(QSPI) Standby */
+		dataL &= ~BIT29;
+		*((volatile uint32*)CPG_CPGWPR)    = ~dataL;
+		*((volatile uint32*)CPG_MSTPCR6)  =  dataL;
+		while (BIT29 & *((volatile uint32*)CPG_MSTPSR6));  /*  wait bit=0 */
+	}
+}
