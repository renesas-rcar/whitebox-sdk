diff --git a/vm_atk2/vm1_atk2/flash/qspi_flash_writer.c b/vm_atk2/vm1_atk2/flash/qspi_flash_writer.c
new file mode 100644
index 0000000..465580a
--- /dev/null
+++ b/vm_atk2/vm1_atk2/flash/qspi_flash_writer.c
@@ -0,0 +1,111 @@
+#include <stdlib.h>
+#include <string.h>
+#include "qspi_flash_writer.h"
+#include "rpc_qspi_driver.h"
+#include "rpc_reg.h"
+#include "iccom_commands.h"
+
+#define		FLASH_SADDR			(0xC8000000U)
+#define		FLASH_SIZE			(0x04000000U)
+#define     FLASH_EADDR         (FLASH_SADDR + FLASH_SIZE)
+
+#define SECTOR_SIZE         (0x00040000U)	// 256kB for erase
+#define SECTOR_SIZE_MASK    (0xFFFC0000U)
+
+#define	S25FL512_SA01_STARTAD		(0x00040000U)
+
+uint32 tmp_page[FLASH_PAGE_SIZE/sizeof(uint32)];
+uint8 is_flash_initialized = 0;
+
+static void flash_init(void)
+{
+	qspi_init();
+	is_flash_initialized = 1;
+}
+
+/*
+ * This function write up to a single page of flash memory
+ */
+sint32 flash_write_chunk(uint32 dest_addr, uint8* data, size_t size)
+{
+	sint32 ret = 0;
+
+	qspi_clear_block_protection();
+	
+	qspi_write_flash_command(0x00060000); /* write enable */
+
+	memset(tmp_page, 0, FLASH_PAGE_SIZE);
+	memcpy(tmp_page, data, size);
+	qspi_write_buf(dest_addr, tmp_page);
+	ret = qspi_wait_for_status_complete();
+	
+	return ret;
+}
+
+sint32 flash_erase(uint32 start, size_t size)
+{
+	uint32 addr, end;
+	sint32 ret = 0;
+
+	if (!is_flash_initialized) {
+		flash_init();
+	}
+
+	start &= SECTOR_SIZE_MASK;
+	end = ((start + size + SECTOR_SIZE) & SECTOR_SIZE_MASK) - 1;
+
+	qspi_clear_block_protection();
+
+	if (start < S25FL512_SA01_STARTAD) {
+		for (addr = 0x0; addr <= 0x7FFF; addr += 0x1000) {
+			qspi_write_flash_command(0x00060000);	/* WRITE ENABLE */
+			qspi_erase_4kb_parameter_sector(addr);
+			ret = qspi_wait_for_status_complete();
+			if (ret) {
+				break;
+			}
+		}
+	}
+	
+	for (addr = start; addr <= end; addr += SECTOR_SIZE) {
+		qspi_write_flash_command(0x00060000);	/* WRITE ENABLE */
+		qspi_erase_256kB_sector(addr);
+		ret = qspi_wait_for_status_complete();
+		if (ret) {
+			break;
+		}
+	}
+	
+	return ret;
+}
+
+sint32 flash_read_chunk(uint32 src_addr, size_t size, void* out_buff)
+{
+	int i;
+	uint32 end_addr;
+
+	if (!is_flash_initialized) {
+		flash_init();
+	}
+	
+	qspi_init_fast_read_mode();
+
+	src_addr &= FLASH_PAGE_SIZE_MASK;
+	src_addr += FLASH_SADDR;
+	end_addr = src_addr + size;
+
+	for (i = 0; src_addr < end_addr; i++, src_addr += 4) {
+		tmp_page[i] = *((uint32*)src_addr);
+	}
+	memcpy(out_buff, tmp_page, FLASH_PAGE_SIZE);
+	
+	return 0;
+}
+
+uint32 flash_read_chip_id(void)
+{
+	uint32 tmp;
+	qspi_read_flash_id(&tmp);
+	
+	return (tmp & 0x00FFFFFF);
+}
