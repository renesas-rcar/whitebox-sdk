-#define SVAR1		1
-#define SVAR2		2
-#define SVAR3		3
-#define SVAR4		4
-
-#define MSGQ1		1
-#define MSGQ2		2
-#define MSGQ3		3
-#define MSGQ4		4
-
-int vmcontest_cnt = 0;
-
-/*
- *  VMCOMのテスト
- */
-void
-vmcomtest(void)
-{
-	unsigned char writedata[8];
-	unsigned char readdata[8];
-	int ercd;
-
-	*((unsigned int *)writedata) = vmcontest_cnt;
-
-	ercd = WriteStateVariable(SVAR1, writedata);
-	if (ercd != E_OK) {
-		syslog(LOG_INFO, "WriteStateVariable(SVAR1) error! ercd = %d", ercd);
-	} else {
-		syslog(LOG_INFO, "WriteStateVariable(SVAR1) = %d", *((unsigned int *)writedata));
-	}
-
-	ercd = ReadStateVariable(SVAR2, readdata);
-	if (ercd != E_OK) {
-		syslog(LOG_INFO, "ReadStateVariable(SVAR2) error! ercd = %d", ercd);
-	}
-	else {
-		syslog(LOG_INFO, "ReadStateVariable(SVAR2) = %d", *((unsigned int *)readdata));
-	}
-
-	ercd = ReadStateVariable(SVAR3, readdata);
-	if (ercd != E_OK) {
-		syslog(LOG_INFO, "ReadStateVariable(SVAR3) error! ercd = %d", ercd);
-	}
-	else {
-		syslog(LOG_INFO, "ReadStateVariable(SVAR3) = %d", *((unsigned int *)readdata));
-	}
-
-	ercd = ReadStateVariable(SVAR4, readdata);
-	if (ercd != E_OK) {
-		syslog(LOG_INFO, "ReadStateVariable(SVAR4) error! ercd = %d", ercd);
-	}
-	else {
-		syslog(LOG_INFO, "ReadStateVariable(SVAR4) = %d", *((unsigned int *)readdata));
-	}
-
-	ercd = WriteMessageQueue(MSGQ1, writedata, 4);
-	if (ercd != E_OK) {
-		syslog(LOG_INFO, "WriteMessageQueue(MSGQ1) error! ercd = %d", ercd);
-	}
-	else {
-		syslog(LOG_INFO, "WriteMessageQueue(MSGQ1) = %d", *((unsigned int *)writedata));
-	}
-
-	ercd = ReadMessageQueue(MSGQ4, readdata);
-	if (ercd < 0) {
-		syslog(LOG_INFO, "ReadMessageQueue(MSGQ4) error! ercd = %d", ercd);
-	}
-	else {
-		syslog(LOG_INFO, "ReadMessageQueue(MSGQ4) = %d", *((unsigned int *)readdata));
-	}
-
-	vmcontest_cnt++;
-}
