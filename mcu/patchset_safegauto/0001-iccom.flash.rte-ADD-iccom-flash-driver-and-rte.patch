+void
+ErrorHook(StatusType Error)
+{
+	TaskType	tskid;
+	StatusType	ercd;
+
+#ifdef IOC_E_NO_DATA
+	/* IOC_E_NO_DATAはエラーではない */
+	if (Error == IOC_E_NO_DATA) {
+		return;
+	}
+#endif /* IOC_E_NO_DATA */
+
+	syslog(LOG_NOTICE, "## ErrorHook is called !! (%d):%s", Error, atk2_strerror(Error));
