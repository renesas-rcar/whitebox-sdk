@@ -0,0 +1,34 @@
+#!/bin/sh
+
+# OSソースコードまでのパス
+OS_PATH=../../atk2-sc1_1.4.2
+
+# A-RTEGENまでのパス
+RTE_PATH=./tool/a-rtegen-1.4.0
+
+# Applicationまでのパス
+APP_PATH=../app/
+
+# ターゲット名
+TARGET=rh850u2a_gcc
+
+# アプリケーション名(OSコンフィギュレーションファイル名)
+APPLICATION=HelloAutosar
+
+# 生成コード一括削除処理
+if [ $1 ] && [ $1 == "del" ]
+then
+	rm -f ./../rte/Rte* ./../app/$APPLICATION.arxml
+	exit
+fi
+
+# コード生成
+
+# ABREXによるARXMLの作成
+ruby $OS_PATH/utils/abrex/abrex.rb $APP_PATH/$APPLICATION.yaml
+
+# A-RTEGENによるA-RTEモジュール作成
+$RTE_PATH/bin/bin/rtegen.sh $OS_PATH/target/$TARGET/target_hw_counter.arxml ./arxml/SystemDesk.arxml $APP_PATH/$APPLICATION.arxml
+
+# Rte_<xxx>ファイルを上位ディレクトリに移動
+mv -f Rte* ./../rte/
