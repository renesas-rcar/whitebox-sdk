+EcuM_Init(void)
+{
+#ifdef TOPPERS_USE_MULTICORE
+	StatusType	ercd;
+	CoreIdType	i;
+#endif /* TOPPERS_USE_MULTICORE */
+
+	/* BSWが必要とするドライバの初期化コールアウト */
+	EcuM_AL_DriverInitZero();
+
+#ifdef TOPPERS_USE_MULTICORE
+	/* マルチコア */
+	if (GetCoreID() == OS_CORE_ID_MASTER) {
+		for (i = 0U; i < TotalNumberOfCores; i++) {
+			if (i != OS_CORE_ID_MASTER) {
+				StartCore(i, &ercd);
+			}
+		}
+		StartOS(MainApp);
+	}
+	else {
+		StartOS(DONOTCARE);
+	}
+#else
+	/* シングルコア */
+	StartOS(MainApp);
+#endif /* TOPPERS_USE_MULTICORE */
+
+	while (1) {
+	}
+}
+
