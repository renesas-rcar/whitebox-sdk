+void qspi_init(void)
+{
+	//power_on_rpc();
+
+	set_rpc_clock_mode(RPC_CLK_40M);
+
+	/*
+	 * IMPORTANT NOTE
+	 * Do not reset RPC from G4 otherwise the RPC.SEC_CONF register will
+	 * be set to 0x100 which prevents the G4 from reading the flash memory
+	 * in "external read mode". Writing and erasing wouldn't be affected.
+	 * The correct value for that register is 0x1FF and that's what we get
+	 * at boot for free (maybe the secure CPU is setting it for us).
+	 */
+	//reset_rpc();
+	set_rpc_ssl_delay();
+
+	*((volatile uint32*)RPC_OFFSET1)= 0x31511144;
+}
