-static uint8
-GetCommand(void)
-{
-	uint8 command;          /* コマンド受信バッファ */
-	uint32 cnt = 0;
-
-	/*
-	 *  コマンドを受信するまでループ
-	 */
-	command = '\0';
-	do {
-		WaitEvent(MainEvt);     /* 10msウェイト */
-		ClearEvent(MainEvt);
-		RecvPolSerialChar(&command);    /* 受信バッファポーリング */
-		if (command == '\n') {
-			command = '\0';
-		}
-		cnt++;
-		if (cnt == 100) {
-			syslog(LOG_INFO, "ATK2 on VM1 : running! (%d)", run_cnt++);
-			cnt = 0;
-			vmcomtest();
-		}
-	} while (command == '\0');
-
-
-	return(command);
-}   /* GetCommand */
