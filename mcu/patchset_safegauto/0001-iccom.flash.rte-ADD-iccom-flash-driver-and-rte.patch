+void qspi_clear_block_protection(void)
+{
+	unsigned char statusReg;
+
+	/* write ENABLE */
+	qspi_write_flash_command(0x00060000);
+	/* write SR1V */
+	qspi_write_any_register(0x00800000, 0x0);
+	while(1) {
+		qspi_read_any_register(0x00800000, &statusReg);
+		if (!(statusReg & BIT0)) {
+			break;
+		}
+	}
+}
+
+sint32 qspi_wait_for_status_complete(void)
+{
+	uint32 status;
+	
+	do {
+		qspi_read_status(&status);
+		if ((status & FLASH_STATUS_ERASE_ERROR)) {
+			return -1;
+		}
+		if (!(status & FLASH_STATUS_BUSY)) {
+			return 0;
+		}
+	} while (1);
+}
