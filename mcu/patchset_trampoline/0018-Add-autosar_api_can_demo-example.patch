+// SPDX-License-Identifier: MIT OR Apache-2.0
+/******************************************************************************
+
+    bsw_can_layer.c
+
+    This program is beasd on Autosar technology.
+    If you want to exploit Autosar technology in automotive or derived application,
+    you have to sign an AUTOSAR Partner's Agreement.
+
+    For more details, please see following:
+    - (original) https://www.autosar.org/faq/
+    - (mirror) https://web.archive.org/web/20190226094843/https://www.autosar.org/faq/
+
+*******************************************************************************/
+
+#include "bsw_can_layer.h"
+
+#define CAN_TX_BUS_NUM 4
+#define CAN_RX_BUS_NUM 4
+#define CAN_MAX_DATA_SIZE 64
+
+static uint8 MSG_TxMsg_A_Bus_data[CAN_TX_BUS_NUM][CAN_MAX_DATA_SIZE];
+static uint8 MSG_TxMsg_A_Bus_length[CAN_TX_BUS_NUM];
+static uint8 MSG_RxMsg_A_Bus_data[CAN_RX_BUS_NUM][CAN_MAX_DATA_SIZE];
+static Com_MsgSizeType  MSG_RxMsg_A_Bus_Length[CAN_RX_BUS_NUM];
+
+static boolean PeriodicSendFlag[CAN_TX_BUS_NUM] = {
+    PeriodicSend_Bus_01, PeriodicSend_Bus_02, PeriodicSend_Bus_03, PeriodicSend_Bus_04,
+};
+static uint32 CAN_ID_ARRAY[CAN_TX_BUS_NUM] = {
+    MSG_TxMsg_A_Bus_01, MSG_TxMsg_A_Bus_02, MSG_TxMsg_A_Bus_03, MSG_TxMsg_A_Bus_04,
+};
+static uint8 CAN_DATA_SIZE[CAN_TX_BUS_NUM] = { 4,8,8,8 };
+
+static uint8 _get_bus_num_from_id(PduIdType PduId){
+    uint8 bus_no;
+    switch (PduId) {
+    case MSG_TxMsg_A_Bus_01: bus_no = 0; break;
+    case MSG_TxMsg_A_Bus_02: bus_no = 1; break;
+    case MSG_TxMsg_A_Bus_03: bus_no = 2; break;
+    case MSG_TxMsg_A_Bus_04: bus_no = 3; break;
+    default: bus_no = -1; break;
+    }
+    return bus_no;
+}
+
+void Com_StopTxIPDU( PduIdType PduId ){
+    uint8 bus_no = _get_bus_num_from_id(PduId);
+    if(bus_no != -1) PeriodicSendFlag[bus_no] = 0;
+}
+void Com_ResumeTxIPDU( PduIdType PduId ){
+    uint8 bus_no = _get_bus_num_from_id(PduId);
+    if(bus_no != -1) PeriodicSendFlag[bus_no] = 1;
+}
+
+void Com_WriteIPDU(PduIdType PduId, uint8 *TxMsg_Data){
+    uint8 i, bus_no = _get_bus_num_from_id(PduId);
+
+    for (i=0; i<CAN_DATA_SIZE[bus_no]; ++i) {
+        MSG_TxMsg_A_Bus_data[bus_no][i] = TxMsg_Data[i];
+    }
+}
+
+void Com_SendIPDU(PduIdType PduId, uint8 *TxMsg_Data){
+    uint8 i, bus_no = -1;
+
+    static Can_PduType can_pdu, *pointer_can_pdu;
+    static PduInfoType pdu_info;
+    static Can_IdType id_without_flags, id_flags;
+    static uint8 payload[TPL_CAN_FD_FRAME_MAXIMUM_PAYLOAD_SIZE];
+
+    bus_no = _get_bus_num_from_id(PduId);
+
+    can_pdu.id = PduId | TPL_CAN_ID_TYPE_STANDARD;
+    can_pdu.sdu = MSG_TxMsg_A_Bus_data[bus_no];
+    can_pdu.length = CAN_DATA_SIZE[bus_no];
+    pdu_info.MetaDataPtr = (uint8 *) &can_pdu;
+    pdu_info.SduDataPtr = can_pdu.sdu;
+    pdu_info.SduLength = sizeof(can_pdu) + can_pdu.length;
+    CanIf_Transmit(0, &pdu_info);
+}
+
+void debug_send( PduLengthType SduLength, uint8* SduDataPtr) {
+    int i, payload_size = SduLength;
+    debug_printf("[G4MH] debug_send: [Payload = %02d byte]: ", payload_size);
+    for (i=0; i<payload_size; ++i)
+        debug_printf("%02x ", SduDataPtr[i]);
+    debug_printf("\r\n");
+}
+
+Com_MsgSizeType Com_ReadIPDUSize(PduIdType PduId ){
+    uint8 bus_no = _get_bus_num_from_id(PduId);
+
+    return MSG_RxMsg_A_Bus_Length[bus_no];
+}
+
+void Com_ReadIPDU(PduIdType PduId, uint8 *MSG_RxMsg_data){
+    uint8 i, bus_no = _get_bus_num_from_id(PduId);
+
+    for (i=0; i<CAN_DATA_SIZE[bus_no]; ++i) {
+        MSG_RxMsg_data[i] = MSG_RxMsg_A_Bus_data[bus_no][i]; 
+    }
+}
+
+/*
+ * This compatible layer specific function
+ */
+void Com_SendIPDU_trigger(void){
+    static int i;
+    for (i=0; i<CAN_TX_BUS_NUM; ++i) {
+        if(PeriodicSendFlag[i])
+            Com_SendIPDU(CAN_ID_ARRAY[i], (uint8*)0);
+    }
+}
+
+void StoreReadData(BswConstR PduInfoType* PduInfoPtr) {
+    uint8 i, bus_no = -1;
+    PduIdType PduId = ((Can_PduType *) PduInfoPtr->MetaDataPtr)->id  & TPL_CAN_ID_TYPE_FD_STANDARD;
+    PduIdType payloadLen = ((Can_PduType *) PduInfoPtr->MetaDataPtr)->length;
+
+    bus_no = _get_bus_num_from_id(PduId);
+
+    for (i=0; i<CAN_DATA_SIZE[bus_no]; ++i) {
+        MSG_RxMsg_A_Bus_data[bus_no][i] = ((Can_PduType *) PduInfoPtr->MetaDataPtr)->sdu[i];
+    }
+    MSG_RxMsg_A_Bus_Length[bus_no] = payloadLen;
+}
+
+uint8 Com_SendSignal(Com_SignalIdType SignalId, const void* SignalDataPtr ){
+    static Can_PduType can_pdu;
+    static PduInfoType pdu_info;
+
+    /* In this implementation, SignalId = CanId */
+    can_pdu.id = SignalId | TPL_CAN_ID_TYPE_FD_STANDARD; /* ToDo: support extend can id/normal can */
+    can_pdu.sdu = (uint8 *)SignalDataPtr;
+    can_pdu.length = 64; // strlen((char *) can_pdu.sdu); /* Current app may use fixed-size */
+    pdu_info.SduDataPtr = can_pdu.sdu;
+    pdu_info.MetaDataPtr = (uint8 *) &can_pdu;
+    pdu_info.SduLength = sizeof(can_pdu) + can_pdu.length;
+    CanIf_Transmit(0, &pdu_info);
+}
+
