+// SPDX-License-Identifier: MIT OR Apache-2.0
+/******************************************************************************
+
+    bsw_can_layer.h
+
+    This program is beasd on Autosar technology.
+    If you want to exploit Autosar technology in automotive or derived application,
+    you have to sign an AUTOSAR Partner's Agreement.
+
+    For more details, please see following:
+    - (original) https://www.autosar.org/faq/
+    - (mirror) https://web.archive.org/web/20190226094843/https://www.autosar.org/faq/
+
+*******************************************************************************/
+
+#ifndef __BSW_CAN_LAYER__
+#define __BSW_CAN_LAYER__
+
+#include <Can.h>
+#include <CanIf.h>
+#include <spider_can.h>
+#include <stdio.h>
+#include <string.h>
+#include <tpl_os.h>
+
+#include "spider_serial.h"
+#include "printf.h"
+
+#define BswConstR const
+#define BSWM_CS_SYSSTAT_BAT (0x01)
+#define BSWM_CS_SYSSTAT_IG  (0x02)
+
+typedef uint32 Com_MsgSizeType;
+typedef uint16 Com_SignalIdType; // from Autosar specifications
+typedef tpl_bool boolean;
+typedef tpl_bool Dem_InitMonitorReasonType; // not used in current swc
+
+/* function which exists on can_demo.c */
+extern void SwcInit( void );
+extern void BswM_CS_CbkPostMainFunctionMid(void);
+extern void Com_CbkTxAck( PduIdType PduId );
+extern void Com_CbkRxAck( PduIdType PduId );
+extern boolean Com_RxIpduCallout( PduIdType PduId, BswConstR PduInfoType* PduInfoPtr );
+
+/* Prototype functions for Autosar specification */
+uint8 Com_SendSignal(Com_SignalIdType, const void* SignalDataPtr );
+
+/* Expand function */
+void Com_StopTxIPDU(PduIdType PduId );
+void Com_ResumeTxIPDU( PduIdType PduId );
+void Com_WriteIPDU(PduIdType PduId, uint8 *TxMsg_Data);
+void Com_SendIPDU(PduIdType PduId, uint8 *TxMsg_Data);
+Com_MsgSizeType Com_ReadIPDUSize(PduIdType PduId );
+void Com_ReadIPDU(PduIdType PduId, uint8 *MSG_RxMsg_A_Bus_01_data);
+
+/* This compatible layer specific function */
+void Com_SendIPDU_trigger(void); // called by 1sec timer function
+void StoreReadData(BswConstR PduInfoType* PduInfoPtr); // stores recived can frame into variable in this layer.
+void debug_send( PduLengthType, uint8*); // outputs CAN frame via debug serial
+
+#endif // __BSW_CAN_LAYER__
+
