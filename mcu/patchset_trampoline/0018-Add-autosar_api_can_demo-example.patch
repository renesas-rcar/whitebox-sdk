+++ b/examples/rh850/autosar_api_can_demo/autosar_api_can_demo.c
@@ -0,0 +1,189 @@
+#include <Can.h>
+#include <CanIf.h>
+#include <spider_can.h>
+#include <stdio.h>
+#include <string.h>
+#include <tpl_os.h>
+
+#include "spider_serial.h"
+#include "printf.h"
+
+#include "bsw_can_layer.h"
+
+#define CPUCLK_MHZ 400UL
+#define WAIT_US(t) \
+    { \
+        volatile uint32 cnt; \
+        for (cnt = 0; \
+             cnt < (((uint32)CPUCLK_MHZ * ((uint32)t)) + (uint32)1); \
+             cnt++); \
+    }
+
+// Statically list the configuration of each CAN controller used in the application
+static tpl_can_controller_config_t can_controllers_config[] =
+{
+	// First controller will use CAN 2.0
+	{
+		&spider_can_controller_0,
+		// CAN-FD at 1Mbps without BRS
+		#if USING_500_KBPS
+		{
+			500, // CanControllerBaudRate
+			0, // CanControllerBaudRateConfigID
+			2, // CanControllerPropSeg, fine tune the bus speed, it is measured at 1MHz
+			5, // CanControllerSeg1
+			2, // CanControllerSeg2
+			2, // CanControllerSyncJumpWidth
+			TRUE, // use_fd_configuration
+			{
+				5000, // CanControllerFdBaudRate, still clocked at 1Mbps
+				2, // CanControllerPropSeg
+				10, // CanControllerSeg1
+				5, // CanControllerSeg2
+				15, // CanControllerSspOffset
+				5, // CanControllerSyncJumpWidth
+				FALSE // CanControllerTxBitRateSwitch
+			}
+		}
+		#else
+		{
+			1000, // CanControllerBaudRate
+			0, // CanControllerBaudRateConfigID
+			1, // CanControllerPropSeg, fine tune the bus speed, it is measured at 1MHz
+			5, // CanControllerSeg1
+			2, // CanControllerSeg2
+			2, // CanControllerSyncJumpWidth
+			TRUE, // use_fd_configuration
+			{
+				5000, // CanControllerFdBaudRate, still clocked at 1Mbps
+				2, // CanControllerPropSeg
+				10, // CanControllerSeg1
+				5, // CanControllerSeg2
+				15, // CanControllerSspOffset
+				5, // CanControllerSyncJumpWidth
+				FALSE // CanControllerTxBitRateSwitch
+			}
+		}
+		#endif
+	}
+};
+
+int main(void)
+{
+	static Can_ConfigType can_config_type =
+	{
+		can_controllers_config,
+		sizeof(can_controllers_config) / sizeof(can_controllers_config[0])
+	};
+	int ret, i;
+	// CAN definition
+	static Can_PduType can_pdu;
+	static PduInfoType pdu_info;
+	static payload = "Ready!";
+
+	// Serial Init
+	Serial_Init();
+	
+	// WAIT_US(44*1000); // This is for debug. delay serial log to show it near U-boot log. 
+	debug_printf("[G4MH] Serial: driver is initialized\r\n");
+
+	// Initialize the CAN module 0 channel 0 with the enabled configuration
+	for (i = 0; i < 3; ++i)
+		ret = Can_Init(&can_config_type);
+	if (ret)
+		return -1;
+	debug_printf("[G4MH] CAN: driver is initialized\r\n");
+#if 0
+	// Send a frame to tell that the program is ready
+	can_pdu.id = 0x123 | TPL_CAN_ID_TYPE_STANDARD;
+	can_pdu.sdu = payload;
+	can_pdu.length = strlen((char *) can_pdu.sdu);
+	pdu_info.SduDataPtr = can_pdu.sdu;
+	pdu_info.MetaDataPtr = (uint8 *)&can_pdu;
+	pdu_info.SduLength = sizeof(can_pdu) + can_pdu.length;
+	CanIf_Transmit(0, &pdu_info);
+#endif
+	SwcInit();
+
+	StartOS(OSDEFAULTAPPMODE);
+	return 0;
+}
+
+/* ISR function for RX*/
+ISR(RSCAN0_RX_Int)
+{
+	static boolean ret;
+	static PduIdType PduId;
+
+	// CAN definition
+	static Can_PduType can_pdu;
+	static PduInfoType pdu_info;
+	static uint8 payload[TPL_CAN_FD_FRAME_MAXIMUM_PAYLOAD_SIZE];
+	static Can_IdType id_without_flags;
+
+	can_pdu.sdu = payload;
+	pdu_info.SduDataPtr = can_pdu.sdu;
+	pdu_info.MetaDataPtr = (uint8 *)&can_pdu;
+
+	while (CanIf_ReadRxPduData(0, &pdu_info) == E_OK) // データが無くなるまでフレーム受信
+	{
+		StoreReadData(&pdu_info); // BSW layer側変数にデータ格納
+		id_without_flags = ((Can_PduType *) pdu_info.MetaDataPtr)->id  & TPL_CAN_ID_STANDARD_MASK;
+		PduId = (PduIdType)id_without_flags;
+		pdu_info.SduLength = sizeof(can_pdu) + can_pdu.length;
+		// debug_printf("[G4MH] CAN ID is 0x%x SduLength=%u\r\n", id_without_flags, pdu_info.SduLength);
+		ret = Com_RxIpduCallout(PduId, &pdu_info);
+		if(!ret)
+			debug_printf("[G4MH] Error on Com_RxIpduCallout function");
+		Com_CbkRxAck(PduId);
+	}
+
+	CallTerminateISR2();
+}
+
+ISR(RSCAN0_RX_IntClear)
+{
+	// debug_printf("[G4MH] RSCAN0_RX_Int is cleared\r\n");
+	spider_can_clear_rx_interrupt(can_controllers_config);
+}
+
+/* ISR function for TX ch0*/
+ISR(RSCAN0_TX_CH0_Int)
+{
+	PduIdType PduId;
+	//static uint32 can_frame = 0;
+	//debug_printf("[G4MH] CAN frame is transmitted(total = %u)\r\n", ++can_frame);
+
+	Com_CbkTxAck( PduId );
+	CallTerminateISR2();
+}
+
+ISR(RSCAN0_TX_CH0_IntClear)
+{
+	// debug_printf("[G4MH] RSCAN0_TX_CH0_Int is cleared\r\n");
+	spider_can_clear_tx_ch0_interrupt(can_controllers_config);
+}
+
+/* Timer callback function */
+DeclareCounter(Software_Counter);
+
+TASK(timer10ms)
+{
+	/*
+	static uint32 elappsed_sec = 0, cnt = 0;
+	if ( (cnt++ % 100) == 0)
+		debug_printf("[G4MH]  10ms timer: %u sec elappsed\n\r", ++elappsed_sec);
+	*/
+	BswM_CS_CbkPostMainFunctionMid();
+
+	TerminateTask();
+}
+
+TASK(timer1000ms)
+{
+	Com_SendIPDU_trigger();
+
+	TerminateTask();
+}
+
+TASK(can_task){} // Dummy function
diff --git a/examples/rh850/autosar_api_can_demo/autosar_api_can_demo.oil b/examples/rh850/autosar_api_can_demo/autosar_api_can_demo.oil
new file mode 100644
index 00000000..3e8298ad
--- /dev/null
+++ b/examples/rh850/autosar_api_can_demo/autosar_api_can_demo.oil
@@ -0,0 +1,139 @@
+OIL_VERSION = "4.0";
+
+IMPLEMENTATION trampoline {
+	/* This fix the default STACKSIZE of tasks */
+	TASK {
+		UINT32 STACKSIZE = 2048 ;
+	};
+
+	/* This fix the default STACKSIZE of ISRs */
+	ISR {
+		UINT32 STACKSIZE = 2048 ;
+	};
+};
+
+CPU can_task {
+	OS config {
+		STATUS = EXTENDED;
+		PAINT_STACK = TRUE;
+		PAINT_REGISTERS = TRUE;
+		BUILD = TRUE {
+			TRAMPOLINE_BASE_PATH = "../../../";
+			APP_SRC = "autosar_api_can_demo.c";
+			APP_SRC = "can_demo.c";
+			APP_SRC = "bsw_can_layer.c";
+			APP_NAME = "autosar_api_can_demo_exe";
+			LDFLAGS="-debug -nocompress -NOOPtimize -memory=high -nologo -SHow=ALL";
+			CFLAGS="-Xcpu=g4mh -g -g_line -Xfxu=off -Xasm_path=.";
+			LINKER = "rlink";
+			SYSTEM = CMAKE;
+			LIBRARY = can;
+			CFLAGS = "-DUSE_CAN_ISR";
+
+			LIBRARY = serial;
+			CFLAGS="-DUSING_500_KBPS"; /* if using 1M(1000k)bps, comment out this line */
+
+			/* CAN Config: TX CAN ID */
+			CFLAGS="-DMSG_TxMsg_A_Bus_01=0x301";
+			CFLAGS="-DMSG_TxMsg_A_Bus_02=0x302";
+			CFLAGS="-DMSG_TxMsg_A_Bus_03=0x703";
+			CFLAGS="-DMSG_TxMsg_A_Bus_04=0x704";
+			/* CAN Config: RC CAN ID */
+			CFLAGS="-DMSG_RxMsg_A_Bus_01=0x304";
+			CFLAGS="-DMSG_RxMsg_A_Bus_02=0x305";
+			CFLAGS="-DMSG_RxMsg_A_Bus_03=0x703";
+			CFLAGS="-DMSG_RxMsg_A_Bus_04=0x501";
+			/* CAN config: Periodic sending ( 0=off, 1=on) */
+			CFLAGS="-DPeriodicSend_Bus_01=1";
+			CFLAGS="-DPeriodicSend_Bus_02=0";
+			CFLAGS="-DPeriodicSend_Bus_03=0";
+			CFLAGS="-DPeriodicSend_Bus_04=0";
+			/* CAN config: misc */
+			CFLAGS="-DComConf_ComSignal_TxSig02=0x302"; /* Same as MSG_TxMsg_A_Bus_02 */
+		};
+		SYSTEM_CALL = TRUE;
+	};
+
+	APPMODE stdAppmode {};
+
+	TASK can_task {
+		PRIORITY = 1;
+		AUTOSTART = TRUE {
+			APPMODE = stdAppmode;
+		};
+		ACTIVATION = 1;
+		SCHEDULE = FULL;
+	};
+
+	ISR RSCAN0_RX_IntClear {
+		CATEGORY = 1;
+		PRIORITY = 1;
+		SOURCE = RSCAN0_RX_Int;
+	};
+
+	ISR RSCAN0_RX_Int {
+		CATEGORY = 2; //FSY unsupported
+		PRIORITY = 1;
+		SOURCE = RSCAN0_RX_Int;
+	};
+
+	ISR RSCAN0_TX_CH0_IntClear {
+		CATEGORY = 1;
+		PRIORITY = 1;
+		SOURCE = RSCAN0_TX_CH0_Int;
+	};
+
+	ISR RSCAN0_TX_CH0_Int {
+		CATEGORY = 2; //FSY unsupported
+		PRIORITY = 1;
+		SOURCE = RSCAN0_TX_CH0_Int;
+	};
+
+	COUNTER Software_Counter {
+		MAXALLOWEDVALUE = 100;
+		TICKSPERBASE = 1;
+		MINCYCLE = 1;
+		TYPE = SOFTWARE;
+		SOURCE = SysTick; // 10msec
+	};
+
+	TASK timer10ms {
+		PRIORITY = 3;
+		AUTOSTART = FALSE;
+		ACTIVATION = 1;
+		SCHEDULE = FULL;
+	};
+	ALARM timer_timer10ms {
+		COUNTER = SystemCounter;
+		ACTION = ACTIVATETASK {
+			TASK = timer10ms;
+		};
+
+		AUTOSTART = TRUE {
+			APPMODE = stdAppmode;
+			ALARMTIME = 1;
+			CYCLETIME = 1;
+		};
+	};
+
+	TASK timer1000ms {
+		PRIORITY = 3;
+		AUTOSTART = FALSE;
+		ACTIVATION = 1;
+		SCHEDULE = FULL;
+	};
+	ALARM timer_timer1000ms {
+		COUNTER = SystemCounter;
+		ACTION = ACTIVATETASK {
+			TASK = timer1000ms;
+		};
+
+		AUTOSTART = TRUE {
+			APPMODE = stdAppmode;
+			ALARMTIME = 100;
+			CYCLETIME = 100;
+		};
+	};
+
+
+};
