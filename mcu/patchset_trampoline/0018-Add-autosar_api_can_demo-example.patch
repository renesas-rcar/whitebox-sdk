@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+/******************************************************************************
+
+    can_demo.c
+
+    This program is beasd on Autosar technology.
+    If you want to exploit Autosar technology in automotive or derived application,
+    you have to sign an AUTOSAR Partner's Agreement.
+
+    For more details, please see following:
+    - (original) https://www.autosar.org/faq/
+    - (mirror) https://web.archive.org/web/20190226094843/https://www.autosar.org/faq/
+
+*******************************************************************************/
+
+#include "bsw_can_layer.h"
+
+static uint8 cyc_msg_buff[4];               /* 定期送信データ(ID:0x301)       */
+static uint8 loop_msg_buff[64];             /* ループバックデータ(ID:0x302)   */
+
+#ifndef MSG_TxMsg_A_Bus_01
+#define MSG_TxMsg_A_Bus_01          0x301
+#endif
+
+#ifndef MSG_RxMsg_A_Bus_04
+#define MSG_RxMsg_A_Bus_04          0x501
+#endif
+
+#ifndef ComConf_ComSignal_TxSig02
+#define ComConf_ComSignal_TxSig02   0x302
+#endif
+
+/*----------------------------------------------------------------------------*/
+/*    ユーザー初期化処理                                                      */
+/*----------------------------------------------------------------------------*/
+void SwcInit( void )
+{
+    int i;
+
+    /* 定期送信データ */
+    cyc_msg_buff[0] = 0x11;
+    cyc_msg_buff[1] = 0x22;
+    cyc_msg_buff[2] = 0x33;
+    cyc_msg_buff[3] = 0x44;
+
+    /* ループバックデータ */
+    for (i = 0; i < 64; i++)
+    {
+        loop_msg_buff[i] = 0x00;
+    }
+
+    return;
+}
+
+/*----------------------------------------------------------------------------*/
+/*    BswM_CS 中優先度処理後通知 - 定期送信データ設定 (CAN ID 0x301)          */
+/*----------------------------------------------------------------------------*/
+void BswM_CS_CbkPostMainFunctionMid( void )
+{
+    static uint8 counter = 0;
+
+    counter++;
+
+    if (counter > 99)
+    {
+        counter = 0;
+
+        Com_WriteIPDU( MSG_TxMsg_A_Bus_01, cyc_msg_buff );
+    }
+
+    return;
+}
+
+/*----------------------------------------------------------------------------*/
+/*    Comメッセージ格納前通知 - ID:0x501で64バイト受信 --> ID:0x302に返送     */
+/*----------------------------------------------------------------------------*/
+boolean Com_RxIpduCallout( PduIdType PduId, BswConstR PduInfoType* PduInfoPtr )
+{
+    uint32 i,len;
+    uint8* ptr;
+
+    switch (PduId)
+    {
+        case MSG_RxMsg_A_Bus_04:
+            len = (uint32) PduInfoPtr->SduLength;
+            ptr = (uint8 *) PduInfoPtr->SduDataPtr;
+
+            while (len >= 64)
+            {
+                for (i = 0; i < 64; i++)
+                {
+                    loop_msg_buff[i] = ptr[i] + 1;
+                }
+                Com_SendSignal(ComConf_ComSignal_TxSig02, loop_msg_buff);
+
+                len -= 64;
+                ptr += 64;
+               }
+
+            break;
+
+        default:
+            break;
+    }
+
+    return TRUE;
+}
+
+/*----------------------------------------------------------------------------*/
+/*    Comメッセージ送信完了通知                                               */
+/*----------------------------------------------------------------------------*/
+void Com_CbkTxAck( PduIdType PduId )
+{
+    return;
+}
+
+/*----------------------------------------------------------------------------*/
+/*    Comメッセージ受信通知                                                   */
+/*----------------------------------------------------------------------------*/
+void Com_CbkRxAck( PduIdType PduId )
+{
+    return;
+}
+
